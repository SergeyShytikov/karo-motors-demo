---
// Outline icons drawn on a 24px grid. Paths follow Lucide (lucide.dev, ISC license).
interface Props {
  name: 'phone' | 'pin' | 'clock' | 'arrow' | 'mail' | 'route' | 'menu' | 'close' | 'chevron';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></>}
  {name === 'arrow' && <path d="M5 12h14M12 5l7 7-7 7" />}
  {name === 'mail' && <><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></>}
  {name === 'route' && <path d="M3 11 22 2l-9 19-2-8-8-2Z" />}
  {name === 'menu' && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === 'close' && <path d="M18 6 6 18M6 6l12 12" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
</svg>
