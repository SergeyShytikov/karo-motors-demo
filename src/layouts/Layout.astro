---
import '../styles/global.css';
import { workshop } from '../data/workshop';
import Icon from '../components/Icon.astro';
import ServiceBrands from '../components/ServiceBrands.astro';

interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active } = Astro.props;
const navigation = [
  { id: 'home', text: 'Startseite', url: '/' },
  { id: 'leistungen', text: 'Leistungen & Preise', url: '/leistungen/' },
  { id: 'kontakt', text: 'Kontakt & Anfahrt', url: '/kontakt/' },
];
const hoursShort = workshop.hours.filter(entry => entry.short !== 'So').map(entry => `${entry.short} ${entry.time}`);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/media/favicon.png" />
    <link rel="preload" href="/fonts/barlow-semi-condensed-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title} | KaRo Motors</title>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt</a>
    <div class="topbar">
      <div class="wrap topbar__inner">
        <a href={workshop.routeUrl} rel="noreferrer"><Icon name="pin" />{workshop.street}, {workshop.city}</a>
        <a href="/kontakt/#oeffnungszeiten"><Icon name="clock" />{hoursShort.join(' · ')}</a>
        <a class="topbar__mail" href={`mailto:${workshop.email}`}><Icon name="mail" />{workshop.email}</a>
      </div>
    </div>
    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="brand" href="/" aria-label="KaRo Motors – Startseite">
          <img src="/media/karo-logo.webp" width="450" height="258" alt="KaRo Motors, Kfz-Meisterbetrieb" />
        </a>
        <a class="call-button" href={workshop.phoneHref}>
          <Icon name="phone" />
          <span class="call-button__number">{workshop.phone}</span>
          <span class="call-button__short">Anrufen</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hauptnavigation">
          <Icon name="menu" class="menu-toggle__open" />
          <Icon name="close" class="menu-toggle__close" />
          <span class="menu-toggle__label">Menü</span>
        </button>
        <nav id="hauptnavigation" class="site-nav" aria-label="Hauptnavigation">
          <ul>
            {navigation.map(({ id, text, url }) => (
              <li><a href={url} aria-current={active === id ? 'page' : undefined}>{text}</a></li>
            ))}
          </ul>
          <div class="site-nav__contact">
            <a href={workshop.routeUrl} rel="noreferrer"><Icon name="pin" /><span>{workshop.street}<br />{workshop.city}<br /><strong>Route planen</strong></span></a>
            <a href="/kontakt/#oeffnungszeiten"><Icon name="clock" /><span>{hoursShort.map(line => <>{line}<br /></>)}</span></a>
            <a href={`mailto:${workshop.email}`}><Icon name="mail" /><span>{workshop.email}</span></a>
          </div>
        </nav>
      </div>
    </header>
    <main id="inhalt" tabindex="-1">
      <slot />
      {active && <ServiceBrands />}
      {active && active !== 'kontakt' && (
        <section class="visit" aria-labelledby="visit-title">
          <div class="wrap visit__inner">
            <div class="visit__lead">
              <h2 id="visit-title">Termin vereinbaren</h2>
              <a class="visit__phone" href={workshop.phoneHref}>{workshop.phone}</a>
            </div>
            <div class="visit__actions">
              <a class="button on-brand" href={workshop.routeUrl} rel="noreferrer"><Icon name="route" />Route planen</a>
              <a class="button on-brand-outline" href="/kontakt/#rueckruf">Rückruf anfragen</a>
            </div>
          </div>
        </section>
      )}
    </main>
    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <img src="/media/karo-logo.webp" width="450" height="258" alt="KaRo Motors" loading="lazy" />
          <p>Kfz-Meisterbetrieb in Hennigsdorf</p>
        </div>
        <div>
          <h2>Kontakt</h2>
          <p><a href={workshop.phoneHref}>{workshop.phone}</a><br /><a href={`mailto:${workshop.email}`}>{workshop.email}</a></p>
        </div>
        <div>
          <h2>Adresse</h2>
          <address>{workshop.street}<br />{workshop.city}</address>
          <a class="footer__route" href={workshop.routeUrl} rel="noreferrer">Route planen</a>
        </div>
        <div>
          <h2>Öffnungszeiten</h2>
          <dl class="footer__hours">
            {workshop.hours.map(entry => <div><dt>{entry.short}</dt><dd>{entry.time}</dd></div>)}
          </dl>
        </div>
      </div>
      <div class="wrap footer__legal">
        <p>Website-Demo · Kontaktdaten der Werkstatt</p>
        <nav aria-label="Rechtliches">
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const header = document.querySelector('.masthead');
        const toggle = header.querySelector('.menu-toggle');
        const label = toggle.querySelector('.menu-toggle__label');
        const nav = document.getElementById('hauptnavigation');
        const setOpen = open => {
          header.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          label.textContent = open ? 'Menü schließen' : 'Menü';
        };
        toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
        nav.addEventListener('click', event => { if (event.target.closest('a')) setOpen(false); });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && header.classList.contains('is-open')) { setOpen(false); toggle.focus(); }
        });
        document.addEventListener('click', event => {
          if (header.classList.contains('is-open') && !header.contains(event.target)) setOpen(false);
        });
        matchMedia('(min-width: 60rem)').addEventListener('change', () => setOpen(false));
      })();
    </script>
  </body>
</html>
