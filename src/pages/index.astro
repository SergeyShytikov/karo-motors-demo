---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { workshop, services, groups, homeCopy, serviceById, formatPrice } from '../data/workshop';
import '../styles/home.css';

const board = ['hu-au', 'inspektion', 'fahrzeugdiagnose', 'bremsenwechsel', 'klimawartung', 'reifenwechsel', 'scheibenwechsel']
  .map(id => serviceById(id))
  .map(service => ({ ...service, label: service.id === 'reifenwechsel' ? 'Räderwechsel' : service.title }));
const index = groups.map(group => ({ ...group, items: services.filter(service => service.group === group.id) }));
const hoursShort = workshop.hours.filter(entry => entry.short !== 'So').map(entry => `${entry.short} ${entry.time}`);
---
<Layout active="home" title="Ihre Meisterwerkstatt in Hennigsdorf" description="KaRo Motors in Hennigsdorf. Werkstattleistungen mit Einstiegspreisen, HU/AU mit der GTÜ vor Ort. Termin telefonisch vereinbaren.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title"><span>Ihre Meisterwerkstatt</span> <em>in Hennigsdorf.</em></h1>
      <p class="hero__intro">{homeCopy.intro}</p>
      <div class="hero__actions">
        <a class="button primary hero__call" href={workshop.phoneHref}><Icon name="phone" />{workshop.phone}</a>
        <a class="button secondary" href={workshop.routeUrl} rel="noreferrer"><Icon name="route" />Route planen</a>
      </div>
      <a class="text-link hero__callback" href="/kontakt/#rueckruf">Rückruf anfragen <Icon name="arrow" /></a>
      <ul class="hero__facts">
        <li><Icon name="pin" />{workshop.street}, {workshop.city}</li>
        <li><Icon name="clock" /><span><span class="nowrap">{hoursShort[0]}</span> · <span class="nowrap">{hoursShort[1]}</span></span></li>
      </ul>
    </div>
    <picture class="hero__photo">
      <source media="(max-width: 40rem)" srcset="/media/workshop-lifts-small.webp" width="760" height="422" />
      <img src="/media/workshop-lifts.webp" alt="Beispielfoto: Autos auf Hebebühnen in einer Kfz-Werkstatt" width="1536" height="930" fetchpriority="high" />
    </picture>
    </div>
  </section>

  <section class="board wrap" aria-labelledby="board-title">
    <h2 id="board-title" class="board__title">Einstiegspreise</h2>
    <ul class="board__list">
      {board.map(item => (
        <li>
          <a href={`/leistungen/#${item.id}`}>
            <span class="board__name">{item.label}</span>
            <span class="board__price"><small>ab</small> {formatPrice(item.price!)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="index wrap" aria-labelledby="index-title">
    <div class="index__head">
      <h2 id="index-title">Leistungen im Überblick</h2>
      <a class="text-link" href="/leistungen/">Alle Leistungen & Preise <Icon name="arrow" /></a>
    </div>
    <div class="index__grid">
      {index.map(group => (
        <div class="index__group">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map(item => <li><a href={`/leistungen/#${item.id}`}>{item.title}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <div class="about__image">
      <img src="/media/diagnostic-laptop.webp" srcset="/media/diagnostic-laptop-small.webp 760w, /media/diagnostic-laptop.webp 1536w" sizes="(max-width: 48rem) 100vw, 50vw" alt="Beispielfoto: Notebook mit Messkurven im Fahrzeuginnenraum" width="1536" height="1025" loading="lazy" />
    </div>
    <div class="about__copy">
      <h2 id="about-title">{homeCopy.aboutTitle}</h2>
      <p>{homeCopy.aboutBody}</p>
      <p class="about__owner"><strong>{workshop.owner}</strong>Inhaber von KaRo Motors</p>
      <a class="text-link" href="/kontakt/">Kontakt & Anfahrt <Icon name="arrow" /></a>
    </div>
  </section>
</Layout>
