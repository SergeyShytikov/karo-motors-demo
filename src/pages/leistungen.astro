---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { services, workshop } from '../data/workshop';
import '../styles/prices.css';

const withPrice = services.filter(service => service.price !== null);
const onRequest = services.filter(service => service.price === null);
const callback = (id: string) => `/kontakt/?leistung=${id}#rueckruf`;
---

<Layout active="leistungen" title="Leistungen & Preise in Hennigsdorf" description="Einstiegspreise für Inspektion, HU/AU, Diagnose, Reifen und Reparaturen bei KaRo Motors in Hennigsdorf.">
  <header class="prices-hero">
    <div class="prices-hero__photo">
      <img src="/media/brake.webp" srcset="/media/brake-small.webp 760w, /media/brake.webp 1536w" sizes="(max-width: 600px) 100vw, 62vw" width="1536" height="1024" alt="" fetchpriority="high" />
    </div>
    <div class="wrap prices-hero__body">
      <h1>Leistungen <span>&amp; Preise</span></h1>
      <nav class="prices-jumps" aria-label="Auf dieser Seite">
        <a href="#preise">Einstiegspreise</a>
        <a href="#auf-anfrage">Preise auf Anfrage</a>
      </nav>
    </div>
  </header>

  <div class="wrap price-catalog">
    <section id="preise" aria-labelledby="prices-heading">
      <div class="catalog-heading">
        <h2 id="prices-heading">Einstiegspreise</h2>
        <p>Den Preis für Ihr Fahrzeug erfahren Sie auf Anfrage.</p>
      </div>
      <div class="price-grid">
        {withPrice.map(service => (
          <article id={service.id} class="price-card">
            <a href={callback(service.id)} aria-label={`${service.title} ab ${service.price} Euro, Rückruf anfragen`}>
              <div class="price-card__heading">
                <h3>{service.title}</h3>
                <Icon name="arrow" />
              </div>
              <p class="price-card__note">{service.note}</p>
              <p class="price-card__price"><small>ab</small> {service.price}<span> €</span></p>
            </a>
          </article>
        ))}
        <aside class="price-help" aria-label="Telefonische Terminvereinbarung">
          <div>
            <h3>Termin vereinbaren</h3>
            <a class="price-help__phone" href={workshop.phoneHref}><Icon name="phone" />{workshop.phone}</a>
          </div>
        </aside>
      </div>
    </section>
    <section id="auf-anfrage" class="request-section" aria-labelledby="request-heading">
      <div class="catalog-heading"><h2 id="request-heading">Preise auf Anfrage</h2></div>
      <ul class="request-grid">
        {onRequest.map(service => (
          <li id={service.id}>
            <a href={callback(service.id)} aria-label={`Preis für ${service.title} erfragen`}>{service.title}<Icon name="arrow" /></a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<script is:inline>
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('arrived');
          observer.unobserve(entry.target);
        }
      }
    });
    for (const card of document.querySelectorAll('.price-grid > *, .request-grid > li')) {
      if (card.getBoundingClientRect().top >= window.innerHeight) observer.observe(card);
    }
  }
</script>
