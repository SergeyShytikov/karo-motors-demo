---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { services, groups, workshop, formatPrice } from '../data/workshop';
import '../styles/prices.css';

const sections = groups.map(group => ({ ...group, items: services.filter(service => service.group === group.id) }));
const callback = (id: string) => `/kontakt/?leistung=${id}#rueckruf`;
const hoursShort = workshop.hours.filter(entry => entry.short !== 'So').map(entry => `${entry.short} ${entry.time}`);
---

<Layout active="leistungen" title="Leistungen & Preise in Hennigsdorf" description="Leistungen und Einstiegspreise von KaRo Motors in Hennigsdorf: HU/AU mit der GTÜ, Inspektion, Diagnose, Bremsen, Fahrwerk, Reifen und mehr.">
  <header class="svc-hero">
    <div class="wrap">
      <h1>Leistungen <em>&amp;&nbsp;Preise</em></h1>
      <p>Alle Preise sind Einstiegspreise. Für den Preis Ihres Fahrzeugs rufen Sie uns an oder bitten Sie um einen Rückruf.</p>
    </div>
  </header>

  <div class="wrap svc-layout">
    <aside class="svc-aside">
      <nav class="svc-nav" aria-label="Leistungsgruppen">
        <ul>
          {sections.map(group => <li><a href={`#${group.id}`}>{group.title}</a></li>)}
        </ul>
      </nav>
      <div class="svc-call">
        <h2>Termin vereinbaren</h2>
        <a class="button primary" href={workshop.phoneHref}><Icon name="phone" />{workshop.phone}</a>
        <p>{hoursShort.join(' · ')}</p>
      </div>
    </aside>

    <div class="svc-groups">
      {sections.map(group => (
        <section id={group.id} class="svc-group" aria-labelledby={`${group.id}-title`}>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          {group.items.map(service => (
            <details id={service.id} class="svc">
              <summary class="svc__head">
                <h3 class="svc__title">{service.title}</h3>
                {service.price !== null ? (
                  <span class="svc__price"><small>ab</small> {formatPrice(service.price)}</span>
                ) : (
                  <span class="svc__on-request">auf Anfrage</span>
                )}
                <Icon name="chevron" class="svc__chevron" />
              </summary>
              <div class="svc__body">
                <p class="svc__summary">{service.summary ?? 'Umfang und Preis besprechen wir mit Ihnen am Telefon.'}</p>
                {service.scope && (
                  <ul class="svc__scope">
                    {service.scope.map(item => <li>{item}</li>)}
                  </ul>
                )}
                {service.note && <p class="svc__note">{service.note}</p>}
                {service.priceFor && <p class="svc__price-for">Der Einstiegspreis gilt für: {service.priceFor}.</p>}
                <div class="svc__actions">
                  <a class="button primary" href={callback(service.id)} aria-label={`Rückruf anfragen: ${service.title}`}>Rückruf anfragen</a>
                  <a class="text-link" href={workshop.phoneHref}><Icon name="phone" />Anrufen</a>
                </div>
              </div>
            </details>
          ))}
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    (() => {
      const all = () => document.querySelectorAll('details.svc');
      const openTarget = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const target = id && document.getElementById(id);
        if (target instanceof HTMLDetailsElement) target.open = true;
      };
      openTarget();
      addEventListener('hashchange', openTarget);
      addEventListener('beforeprint', () => all().forEach(entry => { entry.open = true; }));
    })();
  </script>
</Layout>
